# Application paths. Keep runtime data outside the Git checkout in production.
JARVIS_HOME=/opt/jarvis
JARVIS_DATA_DIR=/var/lib/jarvis/data
JARVIS_MEMORY_DIR=/var/lib/jarvis/memory
JARVIS_WORKSPACE=/var/lib/jarvis/workspace

# Codex runtime
CODEX_BIN=/usr/bin/codex
CODEX_WORKDIR=/var/lib/jarvis/workspace
CODEX_TIMEOUT=240

# DingTalk credentials: set real values only in the server-side .env file.
DINGTALK_APP_KEY=replace-me
DINGTALK_APP_SECRET=replace-me
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ALLOWED_USER_IDS=replace-with-your-dingtalk-sender-id
DINGTALK_ALLOW_ALL_USERS=false
JARVIS_DOWNLOAD_HOSTS=dingtalk.com,aliyuncs.com
JARVIS_DOWNLOAD_MAX_BYTES=26214400

# Optional download and gateway settings
DOWNLOAD_BASE_URL=
DOWNLOAD_BIND_HOST=127.0.0.1
DOWNLOAD_BIND_PORT=18080
GATEWAY_API_KEY=replace-with-a-long-random-secret
GATEWAY_LOG_LEVEL=INFO
