# Copy to .env. scripts/install.sh generates a strong password automatically.
COMPOSE_PROJECT_NAME=jarvis
QWENPAW_IMAGE=docker.io/agentscope/qwenpaw:v2.1.0-beta.2
JARVIS_IMAGE=jarvis:qwenpaw-2.1-codex
OPENAI_CODEX_VERSION=0.144.4
JARVIS_PORT=8088
JARVIS_HTTP_PROXY=http://127.0.0.1:7890
JARVIS_HTTPS_PROXY=http://127.0.0.1:7890
JARVIS_ALL_PROXY=socks5h://127.0.0.1:7890
JARVIS_NO_PROXY=127.0.0.1,localhost,::1,.dingtalk.com
JARVIS_BACKUP_RETENTION=3
QWENPAW_AUTH_USERNAME=jarvis
QWENPAW_AUTH_PASSWORD=CHANGE_ME
QWENPAW_LOG_LEVEL=info
# Optional. Leave empty to use the defaults available to the ChatGPT account.
JARVIS_CODEX_MODEL=
JARVIS_CODEX_REASONING=
TZ=Asia/Shanghai
